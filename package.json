{
  "name": "music-theory-games",
  "version": "0.1.0",
  "private": true,
  "description": "음악이론 모바일 게임 웹앱 — 리듬 모드(한 줄 = 한 마디)와 화음 모드(타일 = 음, 덩어리 = 화음)",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/gen-sw.mjs out",
    "start": "npx --yes serve out",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:play": "vite build --config artifact/vite.config.ts",
    "dev:play": "vite --config artifact/vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "overrides": {
    "postcss": "^8.5.32"
  }
}
